{
  "args": [],
  "artifacts": [
    "result.json",
    "series.jsonl",
    "ckpt.bin",
    "telemetry.jsonl"
  ],
  "canary": "python3 -c \"import cupy; (cupy.ones((256,256),dtype=cupy.float32)@cupy.ones((256,256),dtype=cupy.float32)).sum()\"",
  "dependencies": {
    "pip": [
      "cupy-cuda12x==13.3.0",
      "numpy==2.2.0"
    ]
  },
  "description": "Long steady GPU soak for platform qualification: windowed latency percentiles, device and host memory, a steadily growing artifact and periodic checkpoints. Work units are seconds of soak, read from PROMETHEUS_WORK_UNITS. Optional controlled faults (exit, hang, killserver) for real-provider qualification.",
  "disk_gb": 20,
  "entrypoint": "run.py",
  "env": {
    "SOAK_CKPT_EVERY_S": "600",
    "SOAK_CKPT_MB": "4",
    "SOAK_FAULT": "none",
    "SOAK_FAULT_AT_S": "0",
    "SOAK_N": "4096",
    "SOAK_REPORT_S": "10",
    "SOAK_SEED": "20260926"
  },
  "env_allowlist": [
    "SOAK_CKPT_EVERY_S",
    "SOAK_CKPT_MB",
    "SOAK_FAULT",
    "SOAK_FAULT_AT_S",
    "SOAK_N",
    "SOAK_REPORT_S",
    "SOAK_SEED"
  ],
  "gpu": {
    "alternatives": [
      "NVIDIA RTX 4000 Ada Generation",
      "NVIDIA RTX A5000",
      "NVIDIA L4",
      "NVIDIA GeForce RTX 4090",
      "NVIDIA A40"
    ],
    "class": "NVIDIA RTX A4000",
    "cloud": "SECURE",
    "count": 1
  },
  "max_runtime_s": 4500,
  "name": "soak",
  "telemetry": {
    "interval_s": 10,
    "platform_interval_s": 10
  },
  "version": "1",
  "work_units": {
    "estimate": 3600.0,
    "name": "soak_seconds"
  }
