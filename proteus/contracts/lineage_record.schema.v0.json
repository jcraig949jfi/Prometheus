{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometheus/proteus/lineage_record/v0",
  "title": "Proteus Lineage Record (v0)",
  "description": "One record per descent event. Append-only; never edited; record_id = sha256 of the record without itself. Carries every field brief S8 requires. Produced by proteus.foundry.lineage.descend.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "organism_id", "lineage_id", "generation", "parent_ids", "mutation_seed", "operators", "pre_hash", "post_hash", "state_inheritance_policy", "resource_budget", "runtime_hash", "grammar_hash", "grammar_version", "record_id"],
  "properties": {
    "schema_version": {"const": "proteus.lineage_record.v0"},
    "organism_id":  {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the child's canonical manifest"},
    "lineage_id":   {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "organism_id of the generation-0 root"},
    "generation":   {"type": "integer", "minimum": 1},
    "parent_ids":   {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "description": "[parent] or [parent, splice mate]"},
    "mutation_seed": {"type": "integer", "description": "caller's seed; the operator stream is derived from (seed, parent, mate, grammar_hash)"},
    "operators":    {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["operator", "args", "len_before", "len_after"],
                     "properties": {"operator": {"type": "string"}, "args": {"type": "object"}, "len_before": {"type": "integer"}, "len_after": {"type": "integer"}}}},
    "pre_hash":     {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "parent organism_id (architecture hash before)"},
    "post_hash":    {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "child organism_id (architecture hash after)"},
    "state_inheritance_policy": {"enum": ["PRISTINE", "INHERIT"], "description": "PRISTINE: child starts from its genome; INHERIT: child starts from a named parent checkpoint (the operator supplies the checkpoint_id at encounter time)"},
    "resource_budget": {"type": "object", "required": ["tick_budget", "tape_words", "n_regs", "out_cap"], "additionalProperties": false,
                        "properties": {"tick_budget": {"type": "integer"}, "tape_words": {"type": "integer"}, "n_regs": {"type": "integer"}, "out_cap": {"type": "integer"}}},
    "runtime_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "grammar_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "grammar_version": {"type": "string", "description": "the operator table used, e.g. proteus.grammar.v0.3; older versions remain selectable only to reproduce frozen evidence"},
    "record_id":    {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
