# Runtime state — do not commit
_rotation_state.json
*/state/
*/artifacts/

# Python bytecode (top-level rule overridden by harmonia/agents/** negation;
# re-exclude here)
__pycache__/
**/__pycache__/
*.pyc

# Single-instance lock file
_swarm.pid

# Runtime streams under _logs/ — JSONL + daemon logs are local-only.
# Reviewable artifacts (weekly reports, taint sweep reports) ARE tracked.
_logs/*.jsonl
_logs/*.log
_logs/swarm.stderr.log
_logs/taint_sweeps_completed.json
