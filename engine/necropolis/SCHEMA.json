{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometheus://engine/necropolis/SCHEMA.json",
  "title": "Necropolis Dossier",
  "version": "1.0.0",
  "description": "One historical Prometheus agent examined as an experimental organism. A Necromancer fills identity..disposition (and optionally descendant_candidate); a Cleric may later implement the descendant. This schema is a compatible SUPERSET of engine/ledger/AGENT_AUTOPSIES.jsonl (the autopsy layer) joined to a descendant-experiment layer. See CHARTER.md for the laws it enforces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "autopsy",
    "disposition",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "necropolis_dossier"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "source_paths",
        "evidence_baseline"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "description": "MUST resolve to a ROSTER.jsonl agent_id."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "historical_machine": {
          "type": [
            "string",
            "null"
          ],
          "description": "M1..M4 or null/unknown."
        },
        "historical_kind": {
          "type": [
            "string",
            "null"
          ],
          "description": "tool|daemon|operator|pipeline-stage|healthcheck|machineprobe"
        },
        "historical_operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Repo paths inspected as evidence (code, state, artifacts)."
        },
        "evidence_baseline": {
          "type": "string",
          "minLength": 7,
          "description": "Git SHA at which the evidence was read."
        }
      }
    },
    "original_organism": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "premise": {
          "type": "string",
          "description": "The hypothesis the agent embodied: if we do X, Y follows."
        },
        "mechanism": {
          "type": "string",
          "description": "How it was meant to work."
        },
        "producers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intended_consumers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observed_history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_period": {
          "type": [
            "string",
            "null"
          ]
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifact_counts": {
          "type": "object",
          "additionalProperties": true
        },
        "actual_consumers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consumption_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths/queries proving downstream consumption (or its absence). See CONSUMPTION.jsonl seam in SEAMS.md."
        }
      }
    },
    "autopsy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kill_boundary",
        "surviving_claims",
        "failure_classes",
        "author_error_audit"
      ],
      "properties": {
        "prior_verdicts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Earlier dispositions/autopsies (cited, NOT trusted). LAW N11."
        },
        "failure_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          },
          "description": "Mechanistic failure typing. SHOULD reference an AUTOPSY_TAXONOMY.md cluster when applicable (DEAD-GATING, LOW-BITS-EMISSION, BOUNDED-MENU-SATURATION, SELECTION-DECOUPLED-FROM-SIGNAL, SEAM-BROKEN, SEMANTIC-TASK-SYNTACTIC-TOOL) or NO-DESIGN-FAILURE-ESTABLISHED. The generic label FAILED is forbidden here and in disposition.classification."
        },
        "kill_boundary": {
          "type": "string",
          "minLength": 12,
          "description": "LAW N4: the STRONGEST proposition the evidence legitimately killed, and no stronger. State what is excluded, not merely that it died."
        },
        "surviving_claims": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "LAW N5: mechanisms/premises STILL compatible with the evidence. May be empty only for a defended TRUE_CORPSE."
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictory_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "death_axis": {
          "type": "string",
          "enum": [
            "premise-dead",
            "implementation-dead",
            "measurement-dead",
            "ecosystem-dead",
            "capability-era-dead",
            "bug-dead",
            "parameter-dead",
            "hallucination-dead",
            "undetermined"
          ],
          "description": "CHARTER death-axis vocabulary (LAW N16). Where on the stack the evidence locates the death; orthogonal to disposition.classification. Frankenstein reads this first."
        },
        "capability_contingency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "frontier_dependent": {
              "type": "boolean",
              "description": "Did the kill boundary depend materially on a moving technological frontier?"
            },
            "frontiers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Named frontiers: model capability, context length, tool use, coding ability, inference cost, verifier integration, model reliability, ..."
            },
            "era_bound_claim": {
              "type": "string",
              "description": "The claim as it SHOULD be stated: 'era-E model + mechanism + representation + budget could not do X'."
            },
            "what_would_move_it": {
              "type": "string",
              "description": "What changed capability would re-open the boundary, if any."
            }
          },
          "required": [
            "frontier_dependent"
          ],
          "description": "LAW N16: record whether 'too early' is part of the kill, so it can be tested rather than assumed."
        },
        "contributing_axes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "premise-dead",
              "implementation-dead",
              "measurement-dead",
              "ecosystem-dead",
              "capability-era-dead",
              "bug-dead",
              "parameter-dead",
              "hallucination-dead",
              "undetermined"
            ]
          },
          "description": "Every other axis the evidence supports (LAW N17). A premise-dead verdict reached through a vacuous gate lists the gate as bug-dead here. Frankenstein reads these as repair targets (F7)."
        },
        "author_error_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "design_vs_hypothesis",
            "code_vs_design",
            "execution_parameters",
            "hallucination_scan"
          ],
          "description": "LAW N17. Did a person or model make a mistake that killed this organism? Four lenses over the corpse AND every prior verdict about it. NOT_EXAMINED is honest; CLEAN requires executed evidence.",
          "properties": {
            "design_vs_hypothesis": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict",
                "finding"
              ],
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "CLEAN",
                    "ERROR_FOUND",
                    "NOT_EXAMINED"
                  ]
                },
                "finding": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Paths to the executed evidence (scripts/results) that support the verdict. CLEAN with no evidence is what NOT_EXAMINED is for."
                }
              },
              "description": "Could the experiment as designed have tested the hypothesis as stated?"
            },
            "code_vs_design": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict",
                "finding"
              ],
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "CLEAN",
                    "ERROR_FOUND",
                    "NOT_EXAMINED"
                  ]
                },
                "finding": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Paths to the executed evidence (scripts/results) that support the verdict. CLEAN with no evidence is what NOT_EXAMINED is for."
                }
              },
              "description": "Did the code do what the design said (gates, selectors, loaders, skip sets, label construction)?"
            },
            "execution_parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict",
                "finding"
              ],
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "CLEAN",
                    "ERROR_FOUND",
                    "NOT_EXAMINED"
                  ]
                },
                "finding": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Paths to the executed evidence (scripts/results) that support the verdict. CLEAN with no evidence is what NOT_EXAMINED is for."
                }
              },
              "description": "N, seeds, thresholds, timeouts, model ids, corpus paths, retry policy, daily caps: did the configuration make the run uninformative?"
            },
            "hallucination_scan": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verdict",
                "finding"
              ],
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "CLEAN",
                    "ERROR_FOUND",
                    "NOT_EXAMINED"
                  ]
                },
                "finding": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Paths to the executed evidence (scripts/results) that support the verdict. CLEAN with no evidence is what NOT_EXAMINED is for."
                }
              },
              "description": "False load-bearing facts: nonexistent APIs, invented numbers, misread outputs, causal labels on correlations, artifacts attributed to the wrong producer — in the agent's artifacts or in prior verdicts about it."
            },
            "prior_verdict_errors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Errors found in previous autopsies/dispositions of this organism (LAW N11), stated with the evidence that overturned them."
            }
          }
        }
      }
    },
    "residue": {
      "type": "object",
      "additionalProperties": false,
      "description": "LAW N7: typed salvage, not prose.",
      "properties": {
        "salvageable_code": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "salvageable_data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "salvageable_schemas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "salvageable_operators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "salvageable_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "representation_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "rationale"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "TRUE_CORPSE",
            "PREMISE_ALIVE_IMPLEMENTATION_DEAD",
            "PRODUCER_BLOCKED",
            "CONSUMER_BLOCKED",
            "REPRESENTATION_FAILURE",
            "MEASUREMENT_FAILURE",
            "ORCHESTRATION_FAILURE",
            "RESOURCE_BLOCKED",
            "SUPERSEDED_BUT_ORGANS_SALVAGEABLE",
            "NO_DESIGN_FAILURE_ESTABLISHED",
            "NEEDS_MORE_EVIDENCE"
          ],
          "description": "The archaeological state. There is deliberately NO generic FAILED value; the validator hard-rejects it."
        },
        "rationale": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "descendant_candidate": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "OPTIONAL. Present only when a descendant is PROPOSED. If present the validator enforces LAW N6 (consumer + consumption_proof), N8 (changed_design), N9 (expected_if_alive/dead + kill_condition). A dossier with no proposed descendant sets this to null.",
      "required": [
        "id",
        "parent",
        "changed_design",
        "consumer",
        "consumption_proof",
        "expected_if_alive",
        "expected_if_dead",
        "kill_condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "description": "MUST equal identity.agent_id."
        },
        "changed_design": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "LAW N8: exactly what differs from the historical organism."
        },
        "preserved_mechanism": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consumer": {
          "type": "string",
          "minLength": 1,
          "description": "LAW N6: a concrete named downstream consumer."
        },
        "consumption_proof": {
          "type": "string",
          "minLength": 1,
          "description": "LAW N6: the mechanism that will PROVE consumption (e.g. a CONSUMPTION.jsonl row with a measured effect)."
        },
        "expected_if_alive": {
          "type": "string",
          "minLength": 1
        },
        "expected_if_dead": {
          "type": "string",
          "minLength": 1
        },
        "positive_control": {
          "type": [
            "string",
            "null"
          ]
        },
        "negative_or_decoy_control": {
          "type": [
            "string",
            "null"
          ]
        },
        "kill_condition": {
          "type": "string",
          "minLength": 1,
          "description": "LAW N9: the pre-declared condition that ends the resurrection experiment as a failure."
        },
        "resource_budget": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "investigator",
        "branch",
        "baseline_sha",
        "commands_run"
      ],
      "properties": {
        "investigator": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "Necromancer",
            "Cleric",
            "Keeper"
          ]
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "baseline_sha": {
          "type": "string",
          "minLength": 7
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commands_run": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created": {
          "type": "string"
        }
      }
    }
  }
}