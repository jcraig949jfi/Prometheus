+    assert r_mid["verdict"] == "REACHED_OUTPUT" and set(r_mid["path"]) == {"TRANSPORTED"}
+    r_late = P.reach_certificate(ph, g, HOLD, SEEDS, {TK["ro"][K]: flush}, K)
+    assert r_late["verdict"] == "NOT_REACHED" and r_late["applied"] == 1.0
