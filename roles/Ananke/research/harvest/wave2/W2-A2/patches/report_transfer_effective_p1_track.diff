+# env fields each family's envs.build actually reads (envs.py:155-221)
+_READS = {"HOLD": ("gap", "cue_len", "amp", "amp_dist", "trials", "iti"),
+          "RELAY": ("d", "delta", "cue_len", "amp", "trials", "iti"),
+          "XOR": ("d", "delta", "cue_len", "amp", "trials", "iti"),
+          "MAJ": ("d", "delta", "cue_len", "amp", "trials", "iti", "n_maj", "flip_p"),
+          "FLIP": ("d", "delta", "cue_len", "amp", "amp_teacher", "trials", "block", "iti")}
+
+
+def effective_env(row) -> dict:
+    env = row["env"]
+    keys = [k for k in _READS[env["family"]] if not (k == "d" and row["physics"]["topology"] == "global")]
+    return {"family": env["family"], **{k: env[k] for k in keys}}
+
+
+def condition_changed(src, row) -> bool:
+    """True iff the transfer row's (physics, effective env) differs from its source's."""
+    if src is None:
+        return True
+    return src["physics"] != row["physics"] or effective_env(src) != effective_env(row)
+
