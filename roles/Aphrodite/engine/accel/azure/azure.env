# Azure CPU canary configuration (ACCEL_CANARY_v1). Sourced by run_azure_canary.sh
# and parsed by budget_guard.py (KEY=VALUE lines only, no shell expansion).

# The commit to run. MUST be set by the operator to a pushed SHA on
# aphrodite/accel-azure-cpu-2026-09-23 (the code is shipped with `git archive`
# of exactly this SHA; no GitHub credential is needed on the VM).
PINNED_SHA=

LOCATION=eastus
VM_SIZE=Standard_F16s_v2
WORKERS=16
IMAGE=Canonical:ubuntu-24_04-lts:server:latest
OS_DISK_GB=30
OS_DISK_SKU=StandardSSD_LRS

# Hard wall-clock ceiling for the whole resource group lifetime (minutes).
MAX_MINUTES=90

# ---- price assumptions (USD, pay-as-you-go list, Linux, East US) ----
# ASSUMED, not fetched: verify at
# https://azure.microsoft.com/pricing/details/virtual-machines/linux/ before running.
VM_PRICE_PER_HOUR=0.677
# StandardSSD E4 (32 GiB) ~ $2.40/month  -> ~$0.0033/h
DISK_PRICE_PER_HOUR=0.0033
# Standard static public IPv4 ~ $0.005/h
IP_PRICE_PER_HOUR=0.005
# Egress (<1 MB of results), NSG/VNet: free tier; small fixed allowance anyway.
FIXED_OVERHEAD_USD=0.05
SAFETY_FACTOR=1.10
BUDGET_CAP_USD=3.00
