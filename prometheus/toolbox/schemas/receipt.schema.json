{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometheus.toolbox.receipt.v1",
  "title": "Receipt (core.receipt.v1)",
  "description": "One executed run. What happened, what was measured, by which observer version, under which configuration, on which implementations, at what raw cost, with which replay class. No interpretation. engineering and science key sets are disjoint. receipt_id = sha256(body) so an edit is detectable.",
  "type": "object",
  "required": ["schema", "receipt_id", "experiment_id", "experiment_digest", "arm", "sweep_point", "seed", "status", "components", "capabilities", "replay_class", "trace_hashes", "events_total", "engineering", "science", "accounting", "host", "build", "started_utc", "finished_utc"],
  "properties": {
    "schema": {"const": "prometheus.toolbox.receipt.v1"},
    "receipt_id": {"type": "string", "minLength": 24, "maxLength": 24},
    "experiment_id": {"type": "string"},
    "experiment_digest": {"type": "string"},
    "arm": {"type": "string", "description": "primary | <control kind> | SUMMARY"},
    "sweep_point": {"type": "object"},
    "seed": {"type": "integer"},
    "status": {"enum": ["COMPLETED", "FAILED", "BLOCKED_MISSING_CAPABILITY", "TARGET_UNSUPPORTED", "CONTROL_NOT_MET", "INTEGRITY_HALT"]},
    "components": {"type": "object", "required": ["world", "substrate"],
                   "properties": {"world": {"type": "object"}, "substrate": {"type": "object"}, "players": {"type": "array"}, "observers": {"type": "array"}, "interventions": {"type": "array"}}},
    "capabilities": {"type": "object"},
    "replay_class": {"enum": ["BIT", "SEMANTIC", "PARTIAL", "NONDETERMINISTIC", "NOT_RUN"]},
    "trace_hashes": {"type": "array", "items": {"type": "string"}},
    "events_total": {"type": "integer"},
    "engineering": {"type": "object", "description": "wall_s, cpu_s, ticks, steps_per_s ..."},
    "science": {"type": "object", "description": "observations (by observer kind), world_summary, player_fingerprints, objective, controls"},
    "accounting": {"type": "object", "description": "raw counters: world_steps, transitions, ops, reads, writes, params, state_bytes, wall_s, cpu_s ..."},
    "provenance": {"type": "object"},
    "error": {"type": "string"},
    "registry_rows": {"type": "array"},
    "host": {"type": "object", "required": ["platform", "python", "machine"]},
    "build": {"type": "object", "required": ["kernel_hash", "n_files"]},
    "started_utc": {"type": "string"},
    "finished_utc": {"type": "string"}
  }
}
