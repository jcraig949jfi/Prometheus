  {
   "organ_id": "l1-adaptive-control-basics-xkhainguyen::piecewise_constant_adaptive_law_solving_the_discretised_error_dynamics_for_the_disturbance",
   "fossil_ancestry": "l1-adaptive-control-basics-xkhainguyen",
   "human_name": "estimator() (sigma_hat = -Phi(Ts)^-1 * exp(-am Ts) * x_tilde / b)",
   "human_interpretation": "UNKNOWN",
   "mechanism": "at each sample the prediction error x_tilde = x_hat - x is mapped to the constant disturbance that, held over one period, would produce it under the error dynamics: Phi(Ts) = (1 - exp(-am Ts))/am, mu = exp(-am Ts) x_tilde, sigma_hat = -Phi^-1 mu / b; no gain to tune, no projection: the sampling period IS the adaptation gain",
   "input": "x_tilde, am, b, Ts",
   "output": "sigma_hat (held constant for Ts)",
   "state": "none",
   "update": "per Ts",
   "assumptions": [
    "the disturbance is constant over one sample period; fast sampling makes the estimate track fast disturbances"
   ],
   "interface": "UNKNOWN",
   "dependencies": [
    "UNKNOWN"
   ],
   "parent_mechanism": "WHOLE_SYSTEM",
