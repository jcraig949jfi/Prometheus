   "fossil_ancestry": "particles-chopin-0.4",
   "human_name": "inverse_cdf, uniform_spacings, stratified, systematic, multinomial (resampling.py 485-612)",
   "human_interpretation": "UNKNOWN",
   "mechanism": "all the classical schemes share one O(N+M) pass: walk the cumulative weights once with M SORTED uniforms and emit the index at which each uniform falls; multinomial draws the M sorted uniforms as normalised exponential spacings (O(M) instead of sort), stratified draws one uniform per stratum ((u_m + m)/M), systematic uses a single uniform for all strata ((u + m)/M)",
   "input": "normalised weights W, M sorted uniforms",
   "output": "ancestor indices A",
   "state": "none",
   "update": "per resampling step",
   "assumptions": [
    "the schemes differ in variance, not in expectation: systematic has the lowest variance and is the default in practice; all keep E[#offspring of n] = M W_n"
   ],
