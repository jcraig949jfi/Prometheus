   "organ_id": "lmdb-0.9.31::copy_on_write_page_touch_relinking_the_parent",
   "fossil_ancestry": "lmdb-0.9.31",
   "human_name": "mdb_page_touch (shadow paging)",
   "human_interpretation": "a page is never modified in place; the first write in a transaction copies it",
   "mechanism": "if the page on top of the cursor is not already dirty in this txn: allocate a fresh page (from the freelist or the map end), append the OLD page number to the txn's free list, copy, and point the parent node's page number (or the DB root) at the new page; if the txn has a parent, the page must also be in the child's dirty list",
   "input": "a cursor positioned on a page",
   "output": "a dirty copy in the txn's dirty list; the old pgno on mt_free_pgs",
   "state": "mt_dirty_list, mt_free_pgs, md_root",
   "update": "once per page per txn",
   "assumptions": [
    "readers hold the old root and never see the new page"
   ],
   "interface": "UNKNOWN",
   "dependencies": [
    "UNKNOWN"
   ],
   "parent_mechanism": "WHOLE_SYSTEM",
