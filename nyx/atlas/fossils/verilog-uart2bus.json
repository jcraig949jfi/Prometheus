  {
   "organ_id": "verilog-uart2bus::dual_protocol_command_parser_selected_by_the_first_byte_with_a_text_line_state_machine_and_a_binary_length_prefixed_form",
   "fossil_ancestry": "verilog-uart2bus",
   "human_name": "uart_parser.v main_sm (MAIN_* states), data/addr nibble accumulation, bin_* flags",
   "human_interpretation": "UNKNOWN",
   "mechanism": "a byte of 0x00 in IDLE enters the binary protocol (command byte with read/write/nop bits, auto-increment and status-reply flags, 16-bit address, length, then data bytes counted down to bin_last_byte); an 'r'/'R' or 'w'/'W' enters the text protocol (whitespace, hex data, whitespace, hex address, end of line), where hex characters are accumulated a nibble at a time into data_param/addr_param and any unexpected character parks the machine in EOL until a line end; the request fires on the first non-hex character after the address",
   "input": "rx_data + new_rx_data",
   "output": "read_op/write_op or bin_read_op/bin_write_op with address, data, count",
   "state": "main_sm (4 bits), the parameter registers, the flags",
   "update": "per received byte",
   "assumptions": [
    "0x00 never starts a text command; hex characters and whitespace are the only text tokens; a malformed line is discarded, not reported"
   ],
   "interface": "UNKNOWN",
   "dependencies": [
    "UNKNOWN"
   ],
   "parent_mechanism": "WHOLE_SYSTEM",
   "child_mechanisms": [],
   "composition_neighbors": [
    "verilog-uart2bus::oversampling_receiver_with_two_flop_synchroniser_start_detection_and_mid_bit_sampling",
    "verilog-uart2bus::request_grant_bus_handshake_with_one_cycle_strobes_and_a_pipelined_read_return"
   ],
