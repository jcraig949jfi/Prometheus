  {
   "organ_id": "pyportfolioopt-1.5.5::maximum_sharpe_by_the_cornuejols_tutuncu_variable_substitution",
   "fossil_ancestry": "pyportfolioopt-1.5.5",
   "human_name": "EfficientFrontier.max_sharpe (186-294)",
   "human_interpretation": "UNKNOWN",
   "mechanism": "the Sharpe ratio (return minus risk-free over volatility) is not convex; substitute w = y/k with k > 0: minimise y' Sigma y subject to (mu - rf)' y = 1 and sum(y) = k, and every existing linear constraint rewritten with its constant side multiplied by k; solve; recover w = y/k; the code warns that added non-linear objectives do not transform",
   "input": "expected returns, covariance, risk-free rate",
   "output": "the tangency portfolio",
   "state": "none",
   "update": "per solve",
   "assumptions": [
    "at least one asset beats the risk-free rate (checked); constraints are linear (inequalities and equalities are rewritten; anything else raises)"
   ],
   "interface": "UNKNOWN",
   "dependencies": [
    "UNKNOWN"
   ],
   "parent_mechanism": "WHOLE_SYSTEM",
   "child_mechanisms": [],
   "composition_neighbors": [
