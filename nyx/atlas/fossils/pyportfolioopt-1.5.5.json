   ],
   "fitness_value_in_ancestor": "a quadratic program instead of a non-convex ratio maximisation",
   "failure_landscape": "by reading: the constraint rewriting inspects cvxpy's internal argument order (which side is the Constant) -- brittle across cvxpy versions",
