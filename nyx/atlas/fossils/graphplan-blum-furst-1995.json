  {
   "organ_id": "graphplan-blum-furst-1995::backward_goal_set_extraction_layer_by_layer_choosing_a_non_mutex_achiever_per_goal_with_a_proactive_check_that_remaining_goals_stay_achievable",
   "fossil_ancestry": "graphplan-blum-furst-1995",
   "human_name": "basicplan (planner.c 191-330): goals_at[time][cindex]; in_edges loop with IS_MARKED skip; goals_still_possible; used / is_true counters; the undo block; action_set_is_minimal at the layer boundary",
   "human_interpretation": "UNKNOWN",
   "mechanism": "at a layer, take the next unsatisfied goal (skipping goals already made true by chosen actions), try each achiever (no-ops first) that is not marked mutex with a prior choice: mark its exclusions, check every remaining goal still has an unmarked achiever, add its preconditions to the previous layer's goal set (counting uses so duplicates are shared), recurse to the next goal; when all goals at the layer are served, recurse to the previous layer with the new goal set; undo counters and marks on return; success at time 0",
   "input": "a goal set at the last layer",
   "output": "a plan (the used actions per layer) or failure",
   "state": "goals_at arrays, marks, used/is_true counts",
   "update": "per choice",
   "assumptions": [
    "the mutex relations in the graph make the chosen action set legal without further checking ('it does no other redundant checking')"
   ],
   "interface": "UNKNOWN",
   "dependencies": [
    "UNKNOWN"
   ],
   "parent_mechanism": "WHOLE_SYSTEM",
   "child_mechanisms": [],
