 "organs": [
  {
   "organ_id": "graphplan-blum-furst-1995::forward_construction_of_alternating_fact_and_action_layers_with_a_noop_per_fact_placed_first_until_the_fact_layer_stops_changing",
   "fossil_ancestry": "graphplan-blum-furst-1995",
   "human_name": "create_graph_layer (371-440): copy facts forward, do_operator per op, make_noop_layer, set_uid, find_all_mutex_ops, find_mutex_facts, same_as_prev_flag / first_full_time; make_graph_piece (860-952) builds one action node with its precondition and effect edges",
   "human_interpretation": "UNKNOWN",
   "mechanism": "at each time step the facts are copied to the next layer (linked prev/next), every operator is instantiated against the current facts (an action whose preconditions are pairwise mutex is not inserted: 'Avoiding'), a no-op action per fact is inserted FIRST so the planner tries persistence before change, ids are assigned, mutexes computed, and if the fact count and mutex count equal the previous layer's the graph has levelled off and later layers are copies (make_copy)",
   "input": "ground operators, initial facts",
   "output": "fact_table[t], op_table[t] with edges",
   "state": "the layered graph (hash tables per layer)",
   "update": "per layer",
   "assumptions": [
    "the reachable-fact set and its mutexes are a polynomial-size over-approximation of reachability that tightens the search (the Graphplan insight); levelling off is detectable by counts"
   ],
   "interface": "UNKNOWN",
   "dependencies": [
    "UNKNOWN"
   ],
   "parent_mechanism": "WHOLE_SYSTEM",
   "child_mechanisms": [],
   "composition_neighbors": [
