{
 "schema": "archaeon.fossil_metabolism_s1.prereg.v0",
 "at": "2026-09-12T16:55:19.025100+00:00",
 "status": "PREREGISTERED_NO_ROWS_EMITTED",
 "question": "Does consulting the current fossil record change proposal quality relative to the existing non-fossil / uniform policy?",
 "hypothesis": "H1: on a bitstring landscape already observed, a proposal that USES the fossil (the best previous candidate's bits, one bit flipped) scores higher than a proposal drawn by the existing uniform policy on the same landscape.",
 "null": "H0: paired score difference d = score_F - score_C has median 0 (the fossil carries nothing the uniform draw does not).",
 "arms": {
  "F": "FOSSIL-DIRECTED: bits = the landscape's best fossil candidate with exactly one bit flipped at a position derived from sha256('S1-flip:'+pair_id) mod length; the fossil's bits and score are read from the SFE observation/experiment by id.",
  "C": "CONTROL / EXISTING UNIFORM POLICY: bits drawn by templates.draw_params(bitstring.resample_region.v0, seed=derive_seed(lane,'2026-09-12',template,'S1-C:'+pair_id), region=(seed_root,length)) -- the existing uniform-within-landscape draw; the fossil's bits are not consulted."
 },
 "matching": "same landscape (seed_root,length), same kind evaluate_bitstring, same spec_version 2, same single observation, same consumer and engine, same human path, same day; one F and one C per landscape; F and C submitted as separate singleton candidate sets under one campaign_set 'cs-fossil-s1' with family_id 'fam-s1-<pair_id>' and arm_id F|C.",
 "population": "the 25 directable landscapes in corpus corpus:a4e1cac9192a5ba0396a9b70 (window created_seq 20374..129400), restricted to score_prev >= 0.5625 (13), deduplicated by (seed_root,length) keeping the best fossil (12). The cut is preregistered because the predicted effect for a landscape scales with (score_prev - 0.5); landscapes at 0.5 cannot separate the arms at this budget (predicted E[d] ~ 0).",
 "n_pairs": 12,
 "budget": {
  "rows": 24,
  "path": "human (no autonomous quota)",
  "per_row": "one evaluate_bitstring observation, ~6-15 s on the live consumer",
  "submits": 24
 },
 "primary_metric": "score from the task result (result.repeats[0].result.score, fraction of bits matching the hidden target) -- an existing objective quantity; paired difference d = score_F - score_C per landscape",
 "randomization": "fixed in advance: F flip position and C bits are pure functions of pair_id (sha256) and the lane/day seed; nothing is chosen after seeing any outcome",
 "predicted_under_H1": "E[score_C] = 0.5 for every landscape; E[score_F] = s_prev + (1 - 2 s_prev)/L; F's realised score is EXACTLY s_prev +/- 1/L. So the direction is predictable by arithmetic and this competition is a FLOOR test: if the pipeline carries the fossil's information faithfully, F must win; a failure to win indicts representation/attribution/plumbing, not the arithmetic.",
 "stopping_rule": "emit all 2n rows in one sitting, then stop; no adaptation; read out only when every row is completed or failed (or after 60 min, whichever first: rows still open are treated as failed)",
 "exclusions": "a pair with a failed row on either arm is excluded (recorded); a pair where F and C bits coincide is recorded as NO_DIRECTIONAL_TEST and excluded (none at preregistration: same_bits_F_C false for all)",
 "tie_handling": "d = 0 excluded from the sign test; n_eff = pairs with d != 0",
 "decision_rule": {
  "test": "exact one-sided sign test on d over n_eff pairs, alpha 0.05",
  "critical_wins_for_n": {
   "4": 5,
   "5": 5,
   "6": 6,
   "7": 7,
   "8": 7,
   "9": 8,
   "10": 9,
   "11": 9,
   "12": 10
  },
  "FOSSIL_DIRECTIONAL_SIGNAL": "wins >= critical(n_eff) and mean d > 0",
  "FOSSIL_DIRECTION_HARMFUL": "losses >= critical(n_eff) and mean d < 0",
  "NO_DETECTABLE_ADVANTAGE": "neither, with n_eff >= 8",
  "INDETERMINATE": "n_eff < 8",
  "REPRESENTATION_INSUFFICIENT": "any F row whose engine-held spec bits != preregistered F bits, or whose PEW producer block cannot be joined to this preregistration by request_key -- checked before the sign test; if it happens the verdict is REPRESENTATION_INSUFFICIENT regardless of scores"
 },
 "secondary_readout": "realised score_F vs the arithmetic prediction (s_prev +/- 1/L): every F row must land on one of the two predicted values; any other value is a plumbing failure",
 "identity_carried_on_every_row": [
  "campaign_set cs-fossil-s1",
  "family_id fam-s1-<pair_id>",
  "arm_id F|C",
  "request_key rk-<pair_id>-F|C",
  "policy_version fossil_s1.F.v0 | fossil_s1.C.v0",
  "corpus_hash + window created_seq bounds",
  "source fossil world_id/obs_id/exp_id (F rows; C rows carry the same landscape ids for matching)",
  "matched_control request_key on F, matched_treatment request_key on C",
  "this file's path and commit"
 ],
