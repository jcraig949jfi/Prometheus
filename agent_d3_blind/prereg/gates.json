{
  "prereg_version": "d3-phase1-v1",
  "frozen_utc_date": "2026-08-27",
  "constants": {
    "MAXVAL": 512,
    "MAXLEN": 48,
    "PROG_MAX": 32,
    "N_VALUE_PROBES": 12,
    "N_EXT_PROBES": 4,
    "N_LIVENESS_PROBES": 4,
    "N_ARTIFACT_PROBES": 4,
    "N_SEEDS": 8,
    "SEED_RNG": 20260827,
    "ARTIFACT_PROBE_RNG": 913,
    "SEED_TRIES": 800,
    "RADII": [1, 2, 3, 5, 8],
    "N_MUT_ORDER0": 120,
    "N_MUT_OTHER_ORDERS": 30,
    "CHAIN_WALKS": 24,
    "CHAIN_STEPS": 12,
    "M0_BUDGET_RUNS": 200000,
    "WITNESS_BUDGET_RUNS": 150000,
    "TARGET_RNG": 4242,
    "N_TARGETS_PER_STRATUM": 20,
    "FRESH_SAMPLE_N": 6000,
    "PROBE_STABILITY_SUBSAMPLE": 800,
    "PROBE_STABILITY_TOL": 0.02,
    "ORDERS": [0, 1, 2],
    "ORDER_PERM_RNG_BASE": 101,
    "FUEL": {"S1": 400, "S2": 300, "S3": 80, "S4": 64}
  },
  "gates": {
    "G1": {"name": "VIABLE_NEIGHBOR_RATE",
           "conds": [{"key": "p_valid_r1", "op": ">=", "thr": 0.60},
                     {"key": "p_valid_r3", "op": ">=", "thr": 0.35}]},
    "G2": {"name": "NON_COLLAPSE",
           "conds": [{"key": "p_semdiff_given_valid_r1", "op": ">=", "thr": 0.25}]},
    "G3": {"name": "PHENOTYPE_COUNT",
           "conds": [{"key": "n_semantic_classes", "op": ">=", "thr": 500}]},
    "G4": {"name": "CONSUMER_LIVENESS",
           "conds": [{"key": "frac_valid_with_live_consumer", "op": ">=", "thr": 0.30}]},
    "G5": {"name": "CONNECTIVITY",
           "conds": [{"key": "giant_component_frac", "op": ">=", "thr": 0.50}]},
    "G6": {"name": "TAXONOMY_NEUTRALITY",
           "conds": [{"key": "max_family_share_charged", "op": "<=", "thr": 0.60},
                     {"key": "n_families_ge_5pct", "op": ">=", "thr": 4}]},
    "G7": {"name": "ORDER_ROBUSTNESS",
           "conds": [{"key": "order_gate_agreement", "op": ">=", "thr": 1.0},
                     {"key": "min_family_spearman", "op": ">=", "thr": 0.60}]},
    "G8": {"name": "M0_COVERAGE",
           "conds": [{"key": "best_m0_target_coverage", "op": ">=", "thr": 0.35},
                     {"key": "best_m0_far_coverage", "op": ">=", "thr": 0.20}]},
    "G9": {"name": "M0_FAIRNESS",
           "conds": [{"key": "n_m0_within_half_of_best", "op": ">=", "thr": 2},
                     {"key": "static_no_label_test_pass", "op": ">=", "thr": 1.0}]},
    "G10": {"name": "WITNESS_ACCESS",
            "conds": [{"key": "n_witnesses_constructed", "op": ">=", "thr": 2},
                      {"key": "n_witness_classes_reached_by_m0", "op": ">=", "thr": 1}]}
  },
  "sensitivity": {"perturbation": 0.20, "knife_edge_rule": "pass with margin inside +/-20% band is KNIFE-EDGE"},
  "verdict_precedence": ["SUBSTRATE_INVALID", "VIABILITY_COLLAPSE", "PHENOTYPE_POVERTY",
                          "TAXONOMY_BIASED", "M0_UNFAIR", "M0_COVERAGE_INSUFFICIENT",
                          "WORLD_PHASE_READY"],
  "bases": ["S1", "S2", "S3", "S4"],
  "no_rescue_rule": "after this file is committed: no primitive added, no typing relaxed, no horizon widened, no mutation operator changed, no threshold moved, no fifth basis built"
}
