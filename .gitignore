# agents/ subdirs ignored by default; explicit re-includes below. Using
# `agents/*` (not `agents/`) so individual subdirs can be re-included —
# git refuses to re-include items inside a fully-excluded directory.
agents/*
# Harmonia child-agent swarm lives under harmonia/agents/ — re-included
!harmonia/agents/
!harmonia/agents/**
# Charon child-agent swarm lives under charon/agents/ — re-included
!charon/agents/
!charon/agents/**
# Aporia-operated peer agents (Hypatia D-track, Atalanta E-track) and
# Ergon-operated demand voicer (Pheme) live under agents/ — re-included
