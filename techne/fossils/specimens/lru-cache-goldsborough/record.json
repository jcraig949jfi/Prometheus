  "human_capability_summary": {
    "built_to": "keep the most useful bounded subset of data in fast memory by evicting the least-recently-used entry when capacity is exceeded",
    "pressure": "memory/cache far smaller than the data; every miss costs a slow fetch, so the eviction choice determines performance",
    "success_means": "a high hit rate on workloads with temporal locality, within a fixed capacity"
  },
  "known_human_problem_solved": "bounded-capacity caching by recency",
  "hardware_assumptions": "",
  "human_environmental_pressure": "bounded memory, a working set larger than capacity, temporal-locality (or its absence)",
  "human_failure_condition": "cache thrashing: when the working set exceeds capacity and locality is poor, the hit rate collapses toward zero and the cache is pure overhead",
  "behavioral_entry_point": "access a working set LARGER than the capacity (the harness does this) to induce thrashing -- a pathological-behavior receipt",
