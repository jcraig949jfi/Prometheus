    {
      "name": "replay the counterexample trail (the schedule: low holds the mutex, high blocks, low cannot run)",
      "cmd": "cd Examples && ../Src/spin -t -p pathfinder.pml 2>&1 | tail -12",
      "exit": 0,
      "seconds": 0.81,
      "ok": true,
      "why_not": [],
      "stdout": {
        "text": "  2:\tproc  1 (low:1) pathfinder.pml:41 (state 2)\t[((mutex==free))]\n  3:\tproc  1 (low:1) pathfinder.pml:41 (state 3)\t[mutex = busy]\n  4:\tproc  1 (low:1) pathfinder.pml:42 (state 5)\t[l_state = running]\n  5:\tproc  0 (high:1) pathfinder.pml:27 (state 1)\t[h_state = waiting]\nspin: trail ends after 5 steps\n#processes: 2\n\t\th_state = waiting\n\t\tl_state = running\n\t\tmutex = busy\n  5:\tproc  1 (low:1) pathfinder.pml:46 (state 8)\n  5:\tproc  0 (high:1) pathfinder.pml:28 (state 4)\n2 processes created\n"
