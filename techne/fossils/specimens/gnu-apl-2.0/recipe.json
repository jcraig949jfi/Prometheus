{
  "runner": "docker",
  "image": "prometheus-fossil-c:bookworm",
  "workdir": "upstream/tree/apl-2.0",
  "probe": [
    {
      "name": "g++",
      "cmd": "g++ --version | head -1"
    }
  ],
  "build": [
    {
      "name": "configure + make (readline optional; --without-... kept default)",
      "cmd": "./configure --quiet >/dev/null 2>&1 && make -s >/dev/null 2>&1; test -x src/apl && echo built",
      "timeout": 1800
    }
  ],
  "runs": [
    {
      "name": "whole-array APL: sum of 1..100 and a 5x5 outer-product multiplication table, no loops",
      "cmd": "src/apl --silent --script < $HARNESS/table.apl 2>&1 | grep -vE '^$' | tail -12",
      "expect": {
        "exit": 0,
        "stdout_contains": [
          "5050"
        ],
        "stdout_regex": "5\\s+10\\s+15\\s+20\\s+25"
      },
      "timeout": 300
    }
  ],
  "tests": [],
  "test_kind": "TECHNE",
  "test_classification_if_none": "TECHNE_SMOKE_HARNESS_PASS",
  "classification_if_ok": "RUNNABLE_CONTAINER",
  "notes": "Oracle: +/iota 100 = 5050 and the 5x5 outer product o.x is the multiplication table (rows 5 10 15 20 25 ...), each computed as a whole-array expression with no explicit loop. The interpreter is the fossil; table.apl is Techne's stimulus."
}
