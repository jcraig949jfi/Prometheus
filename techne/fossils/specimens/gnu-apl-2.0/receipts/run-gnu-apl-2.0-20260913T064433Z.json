  "runs": [
    {
      "name": "whole-array APL: sum of 1..100 and a 5x5 outer-product multiplication table, no loops",
      "cmd": "src/apl --silent --script < $HARNESS/table.apl 2>&1 | grep -vE '^$' | tail -12",
      "exit": 0,
      "seconds": 1.48,
      "ok": true,
      "why_not": [],
      "stdout": {
        "text": "5050\n5x5 outer product:\n1  2  3  4  5\n2  4  6  8 10\n3  6  9 12 15\n4  8 12 16 20\n5 10 15 20 25\n      ^D or end-of-input detected (1). Use )OFF to leave APL!\n      ^D or end-of-input detected (2). Use )OFF to leave APL!\n      ^D or end-of-input detected (3). Use )OFF to leave APL!\n      ^D or end-of-input detected (4). Use )OFF to leave APL!\n      *** end of input\n"
      },
