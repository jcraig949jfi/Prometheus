      "cmd": "./testfor t2.hmm t2.1500.seq > $BODY/build/ll_true.txt; ./testfor $BODY/build/trained.hmm t2.1500.seq > $BODY/build/ll_trained.txt; cat $BODY/build/ll_true.txt $BODY/build/ll_trained.txt; awk '/log prob/{gsub(/.*=/,\"\"); v[++n]=$1+0} END{r=(v[2]-v[1])/(v[1]<0?-v[1]:v[1]); if(r<0)r=-r; printf(\"ll_true=%s ll_trained=%s rel_diff=%.4f\\n\", v[1], v[2], r); exit (n==2 && r<0.03)?0:1}' $BODY/build/ll_true.txt $BODY/build/ll_trained.txt",
