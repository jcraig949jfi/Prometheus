    }
  ],
  "build": [
    {
      "name": "configure + make vtest27 in a genuine i386 userland (configure now selects the MMX/SSE/SSE2 butterflies; no ARCH_OPTION override, no source change)",
      "cmd": "./configure >/dev/null 2>&1; make -s vtest27 2>&1 | grep -viE 'warning|deprecated|^a - ' | tail -3; test -x ./vtest27 && echo built",
      "exit": 0,
      "seconds": 4.04,
      "ok": true,
      "why_not": [],
      "stdout": {
        "text": "ar: creating libfec.a\nbuilt\n"
      },
      "stderr": {
        "text": ""
      }
    }
  ],
  "runs": [
    {
      "name": "Viterbi decode a noisy K=7 convolutional code at Eb/N0 = 3.0 dB (SSE2 code path)",
      "cmd": "./vtest27 -e 3.0 -n 200 2>&1 | tail -4",
      "exit": 0,
      "seconds": 0.95,
      "ok": true,
      "why_not": [],
      "stdout": {
        "text": "SIMD CPU detect: x86 Streaming SIMD Extensions 2 (SSE2)\nnframes = 200 framesize = 2048 ebn0 = 3.00 dB gain = 32\nBER 180/409600 (0.000439) FER 32/201 (0.159)\n"
      },
      "stderr": {
        "text": ""
      }
    },
    {
      "name": "the same code at Eb/N0 = 1.0 dB: more errors survive decoding (the pressure knob)",
      "cmd": "./vtest27 -e 1.0 -n 200 2>&1 | tail -2",
      "exit": 0,
      "seconds": 0.9,
      "ok": true,
      "why_not": [],
      "stdout": {
        "text": "nframes = 200 framesize = 2048 ebn0 = 1.00 dB gain = 32\nBER 17163/409600 (0.0419) FER 200/201 (0.995)\n"
      },
      "stderr": {
        "text": ""
      }
    },
    {
      "name": "force the portable C path (-f? no: the PORT decoder is selected by the cpu_mode API; vtest27 has no switch) -- recorded: only the SIMD path is exercised",
      "cmd": "./vtest27 -h 2>&1 | head -5; true",
      "exit": 0,
      "seconds": 0.95,
      "ok": true,
      "why_not": [],
      "stdout": {
        "text": "./vtest27: invalid option -- 'h'\nSIMD CPU detect: x86 Streaming SIMD Extensions 2 (SSE2)\nStarting time trials\nExecution time for 10000 2048-bit frames: 0.00 sec\ndecoder speed: 1.70667e+12 bits/s\n"
      },
      "stderr": {
        "text": ""
      }
    }
  ],
